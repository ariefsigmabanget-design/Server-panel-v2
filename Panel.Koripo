----------------------------------------------------
-- SOUND EFFECT KLIK TOMBOL
----------------------------------------------------
local function playClickSound()
    task.spawn(function()
        pcall(function()
            local sound = Instance.new("Sound", ScreenGui)
            sound.SoundId = "rbxassetid://77120543307812"
            sound.Volume = 1.0
            sound:Play()
            Debris:AddItem(sound, 1)
        end)
    end)
end

