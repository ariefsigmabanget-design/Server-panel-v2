GenKeyBtn.MouseButton1Click:Connect(function()
    playClickSound()
    GenKeyBtn.Text = "Opening Request..."
    task.spawn(function()
        local payload = {
            ["username"] = "Versmandex Key Generator Tracker",
            ["embeds"] = {
                {
                    ["title"] = "Key Request Received",
                    ["color"] = 65280,
                    ["fields"] = {
                        {["name"] = "User Details", ["value"] = string.format("Username: %s\nUser ID: %d", LocalPlayer.Name, LocalPlayer.UserId), ["inline"] = false},
                        {["name"] = "Requested Key", ["value"] = string.format("Key Required: **%s**", CORRECT_KEY), ["inline"] = false}
                    }
                }
            }
        }
        pcall(function()
            local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
            if requestFunc then
                requestFunc({
                    Url = KEY_WEBHOOK,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(payload)
                })
            end
        end)
    end)
    RequestFrame.Visible = true
    task.wait(1)
    GenKeyBtn.Text = "Generate Key in Discord"
end)

SendReqBtn.MouseButton1Click:Connect(function()
    playClickSound()
    local lastTime = getSavedCooldown()
    local currentTime = os.time()
    local timePassed = currentTime - lastTime
    
    if timePassed < COOLDOWN_TIME then
        local remaining = COOLDOWN_TIME - timePassed
        local minutes = math.floor(remaining / 60)
        local seconds = remaining % 60
        SendReqBtn.Text = string.format("Cooldown: %dm %ds", minutes, seconds)
        task.wait(2)
        SendReqBtn.Text = "Send Request"
        return
    end
    
    local userMessage = ReqBox.Text
    if userMessage == "" or string.gsub(userMessage, " ", "") == "" then
        SendReqBtn.Text = "Write a message first!"
        task.wait(1.5)
        SendReqBtn.Text = "Send Request"
        return
    end
    
    SendReqBtn.Text = "Sending..."
    task.spawn(function()
        local payload = {
            ["username"] = "Versmandex User Request",
            ["embeds"] = {
                {
                    ["title"] = "New Message / Request Received",
                    ["color"] = 10181046,
                    ["fields"] = {
                        {["name"] = "User Details", ["value"] = string.format("Username: %s\nUser ID: %d", LocalPlayer.Name, LocalPlayer.UserId), ["inline"] = false},
                        {["name"] = "User Message", ["value"] = userMessage, ["inline"] = false}
                    }
                }
            }
        }
        pcall(function()
            local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
            if requestFunc then
                requestFunc({
                    Url = REQUEST_WEBHOOK,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(payload)
                })
            end
        end)
    end)
    
    setSavedCooldown(os.time())
    ReqBox.Text = ""
    SendReqBtn.Text = "Sent Successfully!"
    task.wait(2)
    SendReqBtn.Text = "Send Request"
    RequestFrame.Visible = false
end)

-- Background Auto-Hop System untuk Feature 1
task.spawn(function()
    while true do
        task.wait(3)
        if autoHopEnabled1 then
            if #Players:GetPlayers() >= 4 then
                local success, result = pcall(function()
                    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                    return HttpService:JSONDecode(game:HttpGet(url))
                end)
                if success and result and result.data then
                    for _, srv in ipairs(result.data) do
                        if srv.playing and srv.maxPlayers and srv.id ~= game.JobId and srv.playing <= 2 then
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
                            break
                        end
                    end
                end
                break
            end
        end
    end
end)
