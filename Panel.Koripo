end)

local searchingActive2 = false
StartBtn2.MouseButton1Click:Connect(function()
    playClickSound()
    searchingActive2 = not searchingActive2
    if searchingActive2 then
        StartBtn2.Text = "Stop Searching"
        StartBtn2.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        task.spawn(function()
            while searchingActive2 do
                StatusLabel2.Text = "Searching..."
                task.wait(0.8)
                local success, result = pcall(function()
                    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                    return HttpService:JSONDecode(game:HttpGet(url))
                end)
                local foundTarget = false
                if success and result and result.data then
                    for _, srv in ipairs(result.data) do
                        if srv.playing and srv.maxPlayers and srv.id ~= game.JobId and srv.playing == 1 then
                            foundTarget = true
                            StatusLabel2.Text = "Found 1 Player Server! Joining..."
                            task.wait(1)
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
                            break
                        end
                    end
                end
                if not foundTarget and searchingActive2 then
                    StatusLabel2.Text = "Retrying (1 Player)..."
                    task.wait(2.5)
                end
            end
        end)
    else
        StartBtn2.Text = "Start Searching (1 Player)"
        StartBtn2.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        StatusLabel2.Text = "Status: Idle"
    end
end)

