task.spawn(function()
    while CreditHUD and CreditHUD.Parent do
        TweenService:Create(CreditHUD, TweenInfo.new(0.8), {BackgroundColor3 = Color3.fromRGB(15, 15, 20)}):Play()
        TweenService:Create(CreditText, TweenInfo.new(0.8), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
