Instance.new("UICorner", ScanBtn1).CornerRadius = UDim.new(0, 6)

local StatusLabel1 = Instance.new("TextLabel", Page1)
StatusLabel1.BackgroundTransparency = 1
StatusLabel1.Position = UDim2.new(0.60, 0, 0, 32)
StatusLabel1.Size = UDim2.new(0.40, 0, 0, 26)
StatusLabel1.Font = Enum.Font.GothamMedium
StatusLabel1.Text = "Ready"
